# ReplayX root runtime configuration
#
# Live Codex worker execution uses your existing Codex/OpenAI authentication on
# this machine. This repo does not read OPENAI_API_KEY directly.

# Optional model override for Codex SDK worker runs.
REPLAYX_CODEX_MODEL=gpt-5-codex

# Diagnosis runs six workers total. This controls how many can execute in
# parallel when live Codex workers are enabled.
REPLAYX_MAX_PARALLEL_WORKERS=4

# Worker toggles. Set to 0 to disable live worker execution and rely on local
# fallback / replay-safe behavior.
REPLAYX_USE_CODEX_REPRO_WORKER=1
REPLAYX_USE_CODEX_DIAGNOSIS_WORKERS=1

# Worker timeouts in milliseconds.
REPLAYX_CODEX_REPRO_TIMEOUT_MS=30000
REPLAYX_CODEX_DIAGNOSIS_TIMEOUT_MS=45000

# Shared local control-plane token for dashboard + Slack integration.
REPLAYX_INTERNAL_API_TOKEN=replace-with-shared-demo-token

# Optional command for fresh realtime incidents. Defaults to package test,
# typecheck, build, or a read-only git status check.
REPLAYX_REALTIME_VALIDATION_COMMAND=git status --short

# Required only when the dashboard should post final run updates back to Slack.
REPLAYX_SLACK_API_URL=http://localhost:3000
